{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "TMDBApi",
            "request": "launch",
            "mainClass": "com.hms.acquisition.datamine.api.TMDBApi",
            "projectName": "media-acquisition-service"
        },
        {
            "type": "java",
            "name": "ImdbAdvancedSearchHandler",
            "request": "launch",
            "mainClass": "com.hms.acquisition.datamine.ImdbAdvancedSearchHandler",
            "projectName": "media-acquisition-service"
        },
        {
            "type": "java",
            "name": "PirateBaySearchHandler",
            "request": "launch",
            "mainClass": "com.hms.acquisition.search.PirateBaySearchHandler",
            "projectName": "media-acquisition-service"
        },
        {
            "type": "java",
            "name": "DatamineGeminiAiHandler",
            "request": "launch",
            "mainClass": "com.hms.acquisition.datamine.DatamineGeminiAiHandler",
            "projectName": "media-acquisition-service"
        },
        {
            "type": "java",
            "name": "DatamineHandler",
            "request": "launch",
            "mainClass": "com.hms.acquisition.datamine.DatamineHandler",
            "projectName": "media-acquisition-service"
        },
        {
            "type": "java",
            "name": "DatamineMovieHandler",
            "request": "launch",
            "mainClass": "com.hms.acquisition.datamine.DatamineMovieHandler",
            "projectName": "media-acquisition-service"
        },
        {
            "type": "java",
            "name": "ExampleRecord",
            "request": "launch",
            "mainClass": "com.hms.shared.sql.ExampleRecord",
            "projectName": "shared-lib"
        },
        {
            "type": "dockerfile",
            "request": "launch",
            "name": "Docker: Build",
            "dockerfile": "Dockerfile",
            "contextPath": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "name": "Debug Frontend",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "Start Vite Dev Server",
            "postDebugTask": "Stop Vite Dev Server"
        },
        {
            "type": "chrome",
            "name": "Debug Frontend (Docker)",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src"
        },
        {
            "type": "java",
            "name": "Debug Catalog Service",
            "request": "launch",
            "mainClass": "com.hms.catalog.CatalogServiceApplication",
            "projectName": "media-catalog-service",
            "cwd": "${workspaceFolder}/backend/media-catalog-service",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Debug Acquisition Service",
            "request": "launch",
            "mainClass": "com.hms.acquisition.AcquisitionServiceApplication",
            "projectName": "media-acquisition-service",
            "cwd": "${workspaceFolder}/backend/media-acquisition-service",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Debug Stream Service",
            "request": "launch",
            "mainClass": "com.hms.stream.StreamServiceApplication",
            "projectName": "media-stream-service",
            "cwd": "${workspaceFolder}/backend/media-stream-service",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Attach Gateway Service (Docker)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5004
        },
        {
            "type": "java",
            "name": "Attach Catalog Service (Docker)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        },
        {
            "type": "java",
            "name": "Attach Acquisition Service (Docker)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5006
        },
        {
            "type": "java",
            "name": "Attach Stream Service (Docker)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5007
        }
    ],
    "compounds": [
        {
            "name": "Debug All Backend Services",
            "configurations": [
                "Debug Catalog Service",
                "Debug Acquisition Service",
                "Debug Stream Service"
            ]
        },
        {
            "name": "Attach All Backend Services (Docker)",
            "configurations": [
                "Attach Gateway Service (Docker)",
                "Attach Catalog Service (Docker)",
                "Attach Acquisition Service (Docker)",
                "Attach Stream Service (Docker)"
            ],
            "stopAll": true
        },
        {
            "name": "Debug Media Acquisition Service (Docker)",
            "preLaunchTask": "Media Acquisition Service Compose Up (Debug)",
            "postDebugTask": "Media Acquisition Service Compose Down (Debug)",
            "configurations": [
                "Attach Acquisition Service (Docker)",
            ],
            "stopAll": true
        },
        {
            "name": "Debug Media Catalog Service (Docker)",
            "preLaunchTask": "Media Catalog Service Compose Up (Debug)",
            "postDebugTask": "Media Catalog Service Compose Down (Debug)",
            "configurations": [
